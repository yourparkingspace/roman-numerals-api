APP_NAME="Book Catalogue API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL from docker-compose.yml (see README). Note the non-default host port.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=book_catalogue
DB_USERNAME=catalogue
DB_PASSWORD=secret

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

# External API
OPEN_LIBRARY_BASE_URL=https://openlibrary.org
